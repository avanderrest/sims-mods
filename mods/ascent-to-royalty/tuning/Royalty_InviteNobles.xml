<?xml version="1.0" encoding="utf-8"?>
<!-- Throne > "Invite Fellow Nobles".
     Summons two or three living members of the dynasty closest in prestige to the acting
     Sim's; at Count (level 4) and above only royal dynasties are considered. A Sim with no
     dynasty gets the lowest-prestige dynasty. atr_main.py adds this affordance to throne
     objects by script and gates it with a Noble-career test, so no object definition is
     overridden.
     s = fnv64("HouseRules_Royalty_InviteNobles") with the high bit set; INVITE_AFFORDANCE_ID
     in atr_main.py must match. -->
<I c="ImmediateSuperInteraction" i="interaction" m="interactions.base.immediate_interaction" n="HouseRules_Royalty_InviteNobles" s="16404971447273659384">
  <T n="display_name">{{string:Invite Fellow Nobles}}</T>
  <T n="pie_menu_priority">1</T>
  <E n="target_type">OBJECT</E>
  <L n="basic_extras">
    <V t="do_command">
      <T n="command">houserules.royalty.invite</T>
      <L n="arguments">
        <V t="participant">
          <E n="argument">Actor</E>
        </V>
      </L>
    </V>
  </L>
</I>
